{
  "name": "dsh-plugin-update",
  "version": "0.1.2",
  "description": "可复用的更新系统装成的 npm 包：任何 DSH 插件照文档能集成检查更新等功能（地图 #579）",
  "license": "MIT",
  "author": "王辰浩",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeatherHunter/dsh-plugin-update.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": "./dist/host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "derive-client-values.mjs",
    "event-list.template.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node build.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "5.6.3"
  }
}
