{
  "name": "dsh-plugin-update",
  "version": "0.18.35",
  "description": "给 DSH 插件加「检查更新 / 安装更新」能力的 npm 包：宿主一段接线 + 面板一个现成组件，查新版、装更新、失败兜底、更新日志与多插件日志一次包掉",
  "license": "MIT",
  "author": "王辰浩",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "self-update",
    "updater",
    "plugin-update",
    "changelog",
    "typescript",
    "dsh-log"
  ],
  "homepage": "https://github.com/FeatherHunter/dsh-plugin-update#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeatherHunter/dsh-plugin-update.git"
  },
  "bugs": {
    "url": "https://github.com/FeatherHunter/dsh-plugin-update/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "types": "./dist/host.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "default": "./dist/panel.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./batch": {
      "types": "./dist/host-batch.d.ts",
      "default": "./dist/host-batch.js"
    },
    "./panel-batch": {
      "types": "./dist/panel-batch.d.ts",
      "default": "./dist/panel-batch.js"
    },
    "./entry": {
      "types": "./dist/entry.d.ts",
      "default": "./dist/entry.js"
    },
    "./entry-batch": {
      "types": "./dist/entry-batch.d.ts",
      "default": "./dist/entry-batch.js"
    },
    "./install-button": {
      "types": "./dist/install-button.d.ts",
      "default": "./dist/install-button.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./log": {
      "types": "./dist/log/index.d.ts",
      "default": "./dist/log/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "derive-client-values.mjs",
    "event-list.template.json",
    "event-list.update.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node build.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "test:batch": "node --test \"tests/batch-*.test.mjs\" \"tests/panel-batch*.test.mjs\" \"tests/entry-batch.test.mjs\"",
    "smoke:log": "npm run build && node scripts/log-smoke.mjs",
    "docs:log": "node scripts/gen-log-catalog.mjs",
    "docs:log:check": "node scripts/gen-log-catalog.mjs --check",
    "check": "npm run typecheck && npm run build && node --test tests/*.test.mjs && npm run gate:bilingual",
    "gate:bilingual": "node scripts/bilingual-gate.mjs",
    "gate:bilingual:release": "node scripts/bilingual-gate.mjs --release"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "dsh-log": "^0.3.4"
  }
}
