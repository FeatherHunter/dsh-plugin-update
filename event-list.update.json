{
  "version": 1,
  "pluginId": "dsh-plugin-update",
  "fieldEnums": {
    "update.wire.ready": {
      "logSink": ["external", "external-unverified", "self", "off"],
      "copyLevel": ["profile", "nested", "repo", "unknown"],
      "hostKind": ["desktop", "desktop-manager", "cli"]
    },
    "update.install.verify": { "result": ["completed", "restart-required", "failed", "interrupted"] },
    "update.install.fail": {
      "stage": ["gate", "exec", "verify"],
      "reason": [
        "host-rejected",
        "timeout",
        "crashed",
        "nonzero-exit",
        "spawn-failed",
        "terminate-failed",
        "version-mismatch",
        "not-registered",
        "env-blocked",
        "noop",
        "gate-refused",
        "unknown"
      ],
      "code": [
        "check-failed",
        "invalid-release",
        "check-expired",
        "update-busy",
        "install-failed",
        "unknown-profile",
        "channel-mismatch",
        "source-install",
        "invalid-installation",
        "installation-changed",
        "pending-restart",
        "registry-conflict",
        "incompatible-node",
        "incompatible-dsh",
        "recovery-required",
        "dev-source",
        "internal",
        "unsupported",
        "none"
      ],
      "check": ["version", "registered", "env", "none"]
    },
    "update.log.degraded": {
      "reason": [
        "no-dsh-log",
        "lease-conflict",
        "write-fail",
        "emit-threw",
        "unknown-event",
        "unknown-field",
        "invalid-enum",
        "client-batch-refused",
        "client-drop-overflow",
        "client-drop-host-refused",
        "client-drop-send-failed",
        "client-drop-disposed"
      ]
    },
    "update.panel.render.fail": {
      "phase": ["mount", "paint", "poll", "global"],
      "kind": [
        "container",
        "plugin-id",
        "call",
        "prefix",
        "poll-ms",
        "mode",
        "auto-check",
        "theme",
        "theme-tokens",
        "locale",
        "render",
        "transport",
        "uncaught",
        "unhandled"
      ]
    },
    "update.changelog.parse": {
      "status": ["ok", "empty", "missing", "fetch-failed", "parse-degraded", "cache-hit"]
    },
    "update.check.done": {
      "blockedReason": [
        "none",
        "unknown-profile",
        "channel-mismatch",
        "source-install",
        "invalid-installation",
        "installation-changed",
        "pending-restart",
        "registry-conflict",
        "incompatible-node",
        "incompatible-dsh",
        "recovery-required",
        "dev-source"
      ],
      "dataSource": ["npm-version", "npm-channel"]
    },
    "update.check.fail": {
      "errorKind": ["timeout", "network", "dns", "tls", "http", "bad-json", "too-large", "shape", "channel", "unknown"]
    },
    "update.status.changed": {
      "kind": ["update-available", "up-to-date", "unknown"],
      "identity": ["update", "first-install", "up-to-date", "unknown"],
      "blockedReason": [
        "none",
        "unknown-profile",
        "channel-mismatch",
        "source-install",
        "invalid-installation",
        "installation-changed",
        "pending-restart",
        "registry-conflict",
        "incompatible-node",
        "incompatible-dsh",
        "recovery-required",
        "dev-source"
      ],
      "unknownCause": ["no-latest", "running-version-unknown", "compare-failed"]
    },
    "update.panel.mount": {
      "autoCheck": ["started", "recent", "disabled", "failed"]
    },
    "update.batch.entry.fail": {
      "stage": ["check", "install", "timeout", "settle"]
    },
    "update.batch.summary": {
      "stoppedBecause": [
        "finished",
        "stopped-after-failure",
        "max-steps",
        "empty",
        "queued",
        "user-cancel",
        "error"
      ]
    },
    "update.queue.transition": {
      "phase": ["queued", "running", "done", "reclaimed", "pruned", "abandoned"]
    },
    "update.lock.anomaly": {
      "kind": ["stale-owner", "release-failed", "busy-owner"]
    }
  },
  "events": {
    "host.call": {
      "level": "info",
      "kind": "resident",
      "fields": ["method", "latencyMs", "ok", "kind", "pluginId"],
      "guard": "一次电话一条；成功且状态未变时轮询不发"
    },
    "host.call.fail": {
      "level": "warn",
      "kind": "resident",
      "fields": ["method", "kind", "error", "errorHash", "pluginId"],
      "codes": ["H_ERR"],
      "guard": "一次失败电话一条；批量电话失败按 method 连续同码只记首次（成功即清记忆），无属主时不发；状态轮询失败按 (pluginId, method) 只按时间窗限速：首次一条、持续失败每 5 分钟一条心跳（窗口内错误码变化不额外落行，下次心跳行带当时原因）、下一次成功清记忆"
    },
    "update.install.exec": {
      "level": "info",
      "kind": "resident",
      "fields": ["route", "ok", "exitCode", "durationMs", "pluginId"],
      "guard": "一次安装执行一条"
    },
    "update.wire.ready": {
      "level": "info",
      "kind": "resident",
      "fields": ["logSink", "logDirHash", "updaterVersion", "copyLevel", "hostKind"],
      "codes": ["H_DIR"],
      "guard": "接线一次一条；外部落点没验证通过时 logSink=external-unverified"
    },
    "update.check.done": {
      "level": "info",
      "kind": "resident",
      "fields": ["ok", "current", "latest", "channel", "source", "latencyMs", "blockedReason", "fallback", "dataSource"],
      "guard": "一次 check 一条；取数走了通道回退时 fallback=true、dataSource=npm-channel"
    },
    "update.check.fail": {
      "level": "warn",
      "kind": "resident",
      "fields": ["stage", "errorKind", "httpStatus", "latencyMs", "source"],
      "guard": "一次 check 一条；errorKind 是失败类别（不是稳定码），认不出写 unknown"
    },
    "update.status.changed": {
      "level": "info",
      "kind": "resident",
      "fields": ["kind", "latest", "runningVersion", "installedVersion", "registered", "identity", "blockedReason", "unknownCause"],
      "guard": "边沿触发：真值元组（kind/latest/runningVersion/installedVersion/registered/identity/blockedReason/unknownCause）未变不发；未知用显式 null，不猜假值"
    },
    "update.install.request": {
      "level": "info",
      "kind": "resident",
      "fields": ["from", "current", "latest", "checkAgeMs", "intentHash"],
      "guard": "一次用户意图一条"
    },
    "update.install.fail": {
      "level": "warn",
      "kind": "resident",
      "fields": ["stage", "reason", "code", "hostCodeHash", "check", "exitCode", "observedVersion", "intentHash"],
      "guard": "一次安装失败一条；同一意图的请求行用 intentHash 聚合，无法归类时 reason=unknown 照记"
    },
    "update.install.verify": {
      "level": "info",
      "kind": "resident",
      "fields": ["result", "installedVersion", "pendingRestart"],
      "guard": "一次安装一条"
    },
    "update.batch.entry.request": {
      "level": "info",
      "kind": "resident",
      "fields": ["total", "ownCount", "foreignCount", "sessionHash"],
      "guard": "一批一条；sessionHash 用批次 id 的指纹把同一批的三条行串起来"
    },
    "update.batch.entry.fail": {
      "level": "warn",
      "kind": "resident",
      "fields": ["targetHash", "sessionHash", "errorKind", "stage", "index", "exitCode"],
      "codes": ["H_TARGET"],
      "guard": "一个目标失败一条；stage 是失败阶段（check/install/timeout/settle），index 是该目标在本批内的序号"
    },
    "update.batch.summary": {
      "level": "info",
      "kind": "resident",
      "fields": ["total", "ok", "failed", "skipped", "durationMs", "sessionHash", "stoppedBecause"],
      "guard": "收尾一批一条；stoppedBecause 说明这一批为什么停（finished 是全部跑完，不是没有失败）；未收尾就停下时另记一条异常停止（queued/stopped-after-failure/user-cancel/error），同一会话同一原因只记一次"
    },
    "update.queue.transition": {
      "level": "info",
      "kind": "resident",
      "fields": ["phase", "waitedMs", "position", "holderHash"],
      "codes": ["H_OWNER"],
      "guard": "相位边沿触发：相位没变不发；被摘掉的待办按意向年龄记 pruned（过期清理）或 abandoned（主动放弃），holderHash 是当时持有队列那家的指纹（队列空则省略）；同一份状态一次写盘可发多条，逐条待办各自成边沿"
    },
    "update.lock.anomaly": {
      "level": "warn",
      "kind": "resident",
      "fields": ["kind", "ageMs", "ownerHash"],
      "codes": ["H_OWNER"],
      "guard": "一次异常一条；busy-owner 说明锁被新鲜持有者占着（ageMs 是它已持有时间，量不出时省略；ownerHash 是持有者指纹），同一持有者连续只记首次"
    },
    "update.store.fail": {
      "level": "warn",
      "kind": "resident",
      "fields": ["op", "reason", "dirHash"],
      "codes": ["H_DIR"],
      "guard": "同一操作连续失败只记首次；dirHash 是失败所在目录的短指纹（绝不入路径原文）"
    },
    "update.panel.mount": {
      "level": "info",
      "kind": "resident",
      "fields": ["mode", "theme", "lang", "pollMs", "autoCheck"],
      "guard": "一次挂载一条；autoCheck 记这面面板挂载后有没有自动跑检查"
    },
    "update.panel.action": {
      "level": "info",
      "kind": "resident",
      "fields": ["action", "bytes", "truncated", "ok", "errorKind", "durationMs", "errorHash"],
      "guard": "一次点击一条"
    },
    "update.panel.render.fail": {
      "level": "error",
      "kind": "resident",
      "fields": ["kind", "phase", "errorHash"],
      "guard": "同一阶段同类别同指纹 60 秒内至多一条"
    },
    "update.check.start": {
      "level": "info",
      "kind": "ondemand",
      "fields": ["trigger", "source"]
    },
    "update.registry.fetch": {
      "level": "info",
      "kind": "ondemand",
      "fields": ["httpStatus", "latencyMs", "registryHost"]
    },
    "update.channel.decide": {
      "level": "info",
      "kind": "ondemand",
      "fields": ["channel", "reason", "from", "to"]
    },
    "update.changelog.parse": {
      "level": "info",
      "kind": "resident",
      "fields": ["version", "entries", "truncated", "degraded", "status", "cached", "source"],
      "guard": "边沿触发：同 (version,status,cached) 的相邻行每进程至多一行（中间夹别的行仍可再发）"
    },
    "update.poll": {
      "level": "info",
      "kind": "ondemand",
      "fields": ["state", "latencyMs"]
    },
    "update.lang.applied": {
      "level": "info",
      "kind": "ondemand",
      "fields": ["lang", "source"]
    },
    "update.panel.state": {
      "level": "info",
      "kind": "ondemand",
      "fields": ["state", "theme", "tokensApplied", "fallback"]
    },
    "update.log.degraded": {
      "level": "warn",
      "kind": "selfmon",
      "fields": ["reason", "event", "field"],
      "guard": "日志管道自己的故障行，落点存在时始终落盘；整行丢弃只记原因，字段级漂移记 (原因, 事件, 字段)，同一组合只记首次"
    }
  }
}
