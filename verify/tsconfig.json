{
  // verify/ 是开发期真机验证层，不参与 npm 发布（不在 package.json files 白名单里）。
  // 它被仓根 tsconfig.json 排除在外，所以单独一份：只做类型检查，不产出 JS。
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    // 场景文件要被 base 的 run 直接 import（Node 原生跑 .ts），所以 import 里带 .ts 扩展名。
    "allowImportingTsExtensions": true
  },
  // 场景复用 selftest/real-machine/base-verify 的 UI driver；ambient 声明跟着一起编。
  "include": [
    "profile.ts",
    "scenarios/**/*.ts",
    "../selftest/tooling/node-ambient.d.ts",
    "../selftest/real-machine/base-verify/node-ambient.d.ts"
  ]
}
